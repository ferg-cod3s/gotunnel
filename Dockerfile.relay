FROM golang:1.23-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /gotunnel-relay ./cmd/gotunnel-relay

FROM alpine:3.20
RUN apk add --no-cache ca-certificates wget && \
    adduser -D -u 1000 gotunnel
COPY --from=builder /gotunnel-relay /usr/local/bin/gotunnel-relay
USER gotunnel
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget --spider -q http://localhost:8080/health || exit 1
ENTRYPOINT ["gotunnel-relay"]
